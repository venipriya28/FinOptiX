# Copy to .env for local configuration. Do not commit real credentials.
POSTGRES_PASSWORD=replace-with-a-local-password
FINOPTIX_DATABASE_URL=postgresql://finoptix:replace-with-a-local-password@localhost:5432/finoptix
FINOPTIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional LAN access: set only the exact origin(s) you use.
# FINOPTIX_CORS_ORIGINS=http://localhost:5173,http://192.168.1.25:5173
# Optional OpenAI-compatible document answer generation. Retrieval still works without these.
# FINOPTIX_LLM_API_KEY=
# FINOPTIX_LLM_MODEL=
# FINOPTIX_LLM_BASE_URL=https://api.openai.com/v1/chat/completions
